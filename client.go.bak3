package catbird

import (
	"context"
	"encoding/json"

	"github.com/jackc/pgx/v5/pgxpool"
)

// Message represents the immutable data, potentially enriched with signals.
type Message struct {
	ID            int64
	Topic         string
	Payload       []byte
	Signals       map[string]json.RawMessage 
	Attempts      int                        
	CorrelationID *string // Natively tracks workflow clusters for auto-cleanup
}

// DBRunner abstracts over pgxpool.Pool and pgx.Tx so the user can pass their own transaction.
type DBRunner interface {
	Exec(ctx context.Context, sql string, arguments ...any) (commandTag []byte, err error) // Use []byte alias for pgconn.CommandTag to keep dependencies simple
}

type poolWrapper struct{ pool *pgxpool.Pool }

func (p *poolWrapper) Exec(ctx context.Context, sql string, args ...any) ([]byte, error) {
	tag, err := p.pool.Exec(ctx, sql, args...)
	return []byte(tag.String()), err
}

type txWrapper struct{ tx interface{} }

func (t *txWrapper) Exec(ctx context.Context, sql string, args ...any) ([]byte, error) {
	// Simple reflection to invoke Exec on a pgx.Tx without importing pgx core everywhere
	type execer interface {
		Exec(context.Context, string, ...any) (interface{}, error)
	}
	tag, err := t.tx.(execer).Exec(ctx, sql, args...)
	if err != nil {
		return nil, err
	}
	type stringer interface { String() string }
	if s, ok := tag.(stringer); ok {
		return []byte(s.String()), nil
	}
	return nil, nil // Fallback
}

// WrapDBRunner wraps a pgx.Pool or pgx.Tx so they implement DBRunner cleanly.
func WrapDBRunner(db interface{}) DBRunner {
	if p, ok := db.(*pgxpool.Pool); ok {
		return &poolWrapper{pool: p}
	}
	return &txWrapper{tx: db}
}

type Client struct{}

func NewClient() *Client {
	return &Client{}
}

// Enqueue publishes the payload and creates a claim atomically.
// Deduplication is handled via the optional dedupKey parameter (enables exactly-once + Leaderless Cron).
// Delays can be injected via the delay parameter (seconds).
// correlationID groups jobs so a workflow can be aborted in one cascade.
func (c *Client) Enqueue(ctx context.Context, runner DBRunner, topic, queue string, payload any, dedupKey *string, correlationID *string, delaySeconds int) error {
	b, err := json.Marshal(payload)
	if err != nil {
		return err
	}

	_, err = runner.Exec(ctx, `
		WITH msg AS (
			INSERT INTO cb_messages (topic, payload, dedup_key) 
			VALUES ($1, $2, $3) 
			ON CONFLICT (dedup_key) DO NOTHING
			RETURNING id
		)
		INSERT INTO cb_claims (message_id, queue, visible_at, correlation_id)
		SELECT id, $4, now() + ($5 || ' seconds')::interval, $6 FROM msg;
	`, topic, b, dedupKey, queue, delaySeconds, correlationID)
	
	if err == nil {
		runner.Exec(ctx, `SELECT pg_notify('cb_queue_' || $1, '')`, queue)
	}

	return err
}

// CancelCascade allows you to abort an entire workflow of generated steps via a correlation ID
func (c *Client) CancelCascade(ctx context.Context, pool *pgxpool.Pool, correlationID string) error {
	_, err := pool.Exec(ctx, `UPDATE cb_claims SET status = 3 WHERE correlation_id = $1`, correlationID)
	return err
}

// GC deletes cleanly completed data older than retentionDays
func (c *Client) GC(ctx context.Context, pool *pgxpool.Pool, retentionDays int) error {
	// First purge any claims that died (Status 3) holding massive delays
	_, err := pool.Exec(ctx, `DELETE FROM cb_claims WHERE status = 3 AND visible_at < now() - ($1 || ' days')::interval`, retentionDays)
	if err != nil {
		return err
	}
	// Flush the immutable payloads out of the database entirely
	_, err = pool.Exec(ctx, `DELETE FROM cb_messages WHERE created_at < now() - ($1 || ' days')::interval`, retentionDays)
	return err
}

// ResolveDependency marks an upstream dependency as completed for a child job
func (c *Client) ResolveDependency(ctx context.Context, runner DBRunner, childMessageID int64) error {
	_, err := runner.Exec(ctx, `UPDATE cb_claims SET dependencies = dependencies - 1 WHERE message_id = $1`, childMessageID)
	return err
}

// DeliverSignal delivers an external payload to a waiting job and decrements its dependency counter
func (c *Client) DeliverSignal(ctx context.Context, runner DBRunner, targetMessageID int64, signalName string, payload any) error {
	b, err := json.Marshal(payload)
	if err != nil {
		return err
	}

	_, err = runner.Exec(ctx, `
		INSERT INTO cb_signals (message_id, name, payload) 
		VALUES ($1, $2, $3) 
		ON CONFLICT DO NOTHING;
	`, targetMessageID, signalName, b)

	if err == nil {
		_, err = runner.Exec(ctx, `UPDATE cb_claims SET dependencies = dependencies - 1 WHERE message_id = $1`, targetMessageID)
	}

	return err
}
